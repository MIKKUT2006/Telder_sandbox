            );

        }


        GameObject item =
            new GameObject(
                "HeldItem"
            );


        item.hideFlags =
            HideFlags.HideAndDontSave;


        item.transform.SetParent(
            previewHandPoint,
            false
        );


        previewHeldRenderer =
            item.AddComponent<
