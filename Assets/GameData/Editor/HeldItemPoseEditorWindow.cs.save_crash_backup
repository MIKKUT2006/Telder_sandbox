    private void EditorUpdate()
    {

        double now =
            EditorApplication.timeSinceStartup;


        float delta =
            lastEditorTime >
            0.0
                ? (float)(
                    now -
                    lastEditorTime
                )
                : 0f;


        lastEditorTime =
            now;


        if (
            playing
            &&
            GetSelectedClip() !=
            null
        )
        {

            AnimationClip clip =
                GetSelectedClip();


            animationTime +=
                delta *
                playbackSpeed;


            if (
                clip.length >
                0f
            )
            {

                if (
                    loop
                )
                {

                    animationTime =
                        Mathf.Repeat(
                            animationTime,
                            clip.length
                        );

                }
                else
                {

                    animationTime =
                        Mathf.Clamp(
                            animationTime,
                            0f,
                            clip.length
                        );


                    if (
                        animationTime >=
                        clip.length
                    )
                    {

                        playing =
                            false;

                    }

                }

            }


            Repaint();

        }
        else if (
            previewMining
            &&
            autoMiningSwing
        )
        {

            Repaint();

        }

    }


