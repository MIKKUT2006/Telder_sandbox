                    continue;

                }


                visible.Add(
                    renderer
                );

            }

        }


        if (
            visible.Count ==
            0
        )
        {

            int sourceRendererCount =
                player !=
                null
                    ? player.GetComponentsInChildren<
                        SpriteRenderer
                    >(
                        true
                    ).Length
                    : 0;


