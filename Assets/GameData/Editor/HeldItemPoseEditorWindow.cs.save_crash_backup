                generatedItemSprite
            );


            generatedItemSprite =
                null;

        }


        if (
            previewPlayer !=
            null
        )
        {

            DestroyImmediate(
                previewPlayer
            );

        }


        previewPlayer =
            null;
        previewAnimationRoot =
