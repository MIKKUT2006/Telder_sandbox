                int i = 0;
                i < structures.Count;
                i++
            )
            {
                StructureDefinition structure =
                    structures[i];


                if (
                    structure ==
                    null
                )
                {
                    continue;
                }


                if (
                    GUILayout.Button(
                        "Загрузить: " +
                        structure.DisplayName
                    )
                )
                {
                    LoadStructure(
